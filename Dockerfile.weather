# Runtime image - using alpine for CA certificates
FROM alpine:3.24

# Install CA certificates for HTTPS requests
RUN apk add --no-cache ca-certificates

# Build args (passed by goreleaser)
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown
ARG TARGETPLATFORM

# Copy the pre-built binary from goreleaser's build context
COPY ${TARGETPLATFORM}/heizsaison-weather /heizsaison-weather

# Expose metrics/status port
EXPOSE 8081

ENTRYPOINT ["/heizsaison-weather"]
CMD ["run"]
